# 文本模型验证配置。复制为 .env 后填写；.env 已加入 .gitignore。
# experiments 中的真实接口验证脚本使用这些字段。
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 填写已开通模型的 Model ID，或控制台示例要求的 Endpoint ID。
ARK_MODEL=
# Local context budget, including system instructions and tool schemas.
# Keep within your configured model's supported context length.
ARK_CONTEXT_WINDOW_TOKENS=64000

# 麦当劳官方 MCP，通过 https://open.mcd.cn/mcp 登录后激活获取。
MCD_MCP_TOKEN=

# 瑞幸官方 https://open.lkcoffee.com/mcp 登录后取得 Token。
LUCKIN_MCP_TOKEN=
# 滴滴官方 https://mcp.didichuxing.com/ 激活 Key；直发权限依账号核实。
DIDI_MCP_KEY=
# 由家人在真实交易验收后开启。每次仍需核对具体方案并明确二次确认。
LUCKIN_ORDER_ENABLED=false
DIDI_ORDER_ENABLED=false

# 默认只查询和核价。完成确认机制评审后才能主动开启真实订单创建。
MCD_ORDER_ENABLED=false

# 豆包语音控制台 https://console.volcengine.com/speech 的 API Key（不同于 ARK 文本 Key）。
# 开通流式语音识别 2.0 和语音合成 2.0 后填写；密钥仅保存在本地后端。
DOUBAO_SPEECH_API_KEY=
DOUBAO_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
DOUBAO_TTS_VOICE=zh_female_vv_uranus_bigtts
